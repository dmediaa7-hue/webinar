# Production backend URL (Node.js + Socket.io).
# InfinityFree is static-only - it CANNOT run Node.js or mod_proxy, so the
# browser connects DIRECTLY to this URL. CORS on the server is open for any origin.
#
# IMPORTANT: Replace with your real deployed backend URL before building, e.g.:
#   https://webinar-api.onrender.com   (Render free tier)
#   https://webinar-api.up.railway.app (Railway)
#
# The URL must be HTTPS (WebRTC + Socket.io require a secure context in prod).
VITE_SERVER_URL=https://your-backend-url.onrender.com