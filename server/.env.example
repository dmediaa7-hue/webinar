PORT=3001
CLIENT_URL=http://localhost:5173
STUN_URL=stun:stun.l.google.com:19302

# JWT_SECRET=change-me-in-prod

# --- WebRTC TURN relay (optional but recommended for remote calls) ---
# STUN-only ICE fails when both peers sit behind symmetric NAT/CGNAT. The server
# serves short-lived relay credentials at GET /api/turn-credentials using the
# first provider that is configured, in this order:
#
#   1. Static relay (self-hosted coturn / fixed-credential provider):
#      TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
#      TURN_USERNAME=user
#      TURN_CREDENTIAL=secret
#
#   2. Cloudflare Realtime (free 1,000 GB/month tier):
#      dashboard.cloudflare.com -> Realtime -> TURN keys -> Create key.
#      CLOUDFLARE_TURN_KEY_ID=
#      CLOUDFLARE_TURN_API_TOKEN=
#
#   3. Metered Realtime (free 20 GB/month tier):
#      metered.ca -> sign up (free) -> dashboard -> your app subdomain
#      (the part before .metered.live) + an API key.
#      METERED_APP_NAME=
#      METERED_API_KEY=
#
#   4. Open Relay legacy default (no config) - served only while a live STUN
#      probe confirms it answers; otherwise the endpoint reports configured:false.

# Turso (libSQL) remote database. When set, the server runs an embedded
# read-replica that syncs to Turso every 60s — so prod data survives Render
# redeploys (its free tier has no persistent disk). Database URL from
# `turso db show <name> --url`; token from `turso db tokens create <name>`.
# TURSO_DATABASE_URL=libsql://webinar-<org>.turso.io
# TURSO_AUTH_TOKEN=