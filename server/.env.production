# Production defaults committed to the repo. Loaded by src/index.js with
# dotenv override:false - real env vars / server/.env always win over these.
# This lets the Render deployment work without dashboard-managed env vars.
CLIENT_URL=https://dmatest.rf.gd

# Point the SQLite database at durable storage. Render's filesystem is
# ephemeral - it resets on every deploy, which wipes accounts/sessions.
# Attach a Persistent Disk (e.g. mounted at /var/data) and set:
#   DB_PATH=/var/data/webinar.db
# Local development keeps the default server/data/webinar.db.
# DB_PATH=

# WebRTC TURN relay - the server serves the free Open Relay public relay
# (openrelay.metered.ca) automatically: no account, no env vars needed.
# STUN-only calls fail behind symmetric NAT/CGNAT; the relay fixes that.