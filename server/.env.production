# Production defaults committed to the repo. Loaded by src/index.js with
# dotenv override:false - real env vars / server/.env always win over these.
# This lets the Render deployment work without dashboard-managed env vars.
CLIENT_URL=https://dmatest.rf.gd

# Point the SQLite database at durable storage. Render's filesystem is
# ephemeral - it resets on every deploy, which wipes accounts/sessions.
# Attach a Persistent Disk (e.g. mounted at /var/data) and set:
#   DB_PATH=/var/data/webinar.db
# Local development keeps the default server/data/webinar.db.
# DB_PATH=

# WebRTC TURN relay - providers in priority order: static env relay
# (TURN_URLS/TURN_USERNAME/TURN_CREDENTIAL), Cloudflare Realtime
# (CLOUDFLARE_TURN_KEY_ID/_API_TOKEN, free 1,000 GB/month), Metered Realtime
# (METERED_APP_NAME/METERED_API_KEY - the app subdomain + free API key from
# dashboard.metered.ca, free 20 GB/month), then the Open Relay legacy default -
# which is only served while a live STUN probe confirms it answers, and is
# reported as configured:false when dead. STUN-only calls fail behind symmetric
# NAT/CGNAT; the relay fixes that.